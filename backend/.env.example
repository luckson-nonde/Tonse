# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tonse_user
DB_PASSWORD=tonse_password_secure_change_me
DB_NAME=tonse_db
# PRODUCTION: keep false — synchronize can drop columns/tables (data loss).
DB_SYNCHRONIZE=false
# PRODUCTION: set true so pending TypeORM migrations auto-apply on boot.
# NEVER enable together with DB_SYNCHRONIZE. Leave false in dev.
DB_RUN_MIGRATIONS=false
# false by default — TypeORM's query logging includes bound PARAMETER
# VALUES (pre-hash passwords, PINs, NRC numbers), not just SQL statements.
# Only turn this on temporarily for local debugging.
DB_LOGGING=false

# Comma-separated allowed browser origins in production (the frontend URL[s]),
# e.g. https://tonse.onrender.com. Only read when NODE_ENV=production.
CORS_ORIGINS=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# ALWAYS give these a unit. jsonwebtoken parses a bare number in a STRING as
# MILLISECONDS, so `3600` means 3.6 SECONDS, not an hour — which logs users
# out on their first click. Use 1h / 7d / 3600s, never a bare number.
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRATION=7d

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_character_iv_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── Payments: DPO (Direct Pay Online) ────────────────────────────────
# 'sandbox' = no network, full lifecycle, in-app "simulate approval" button.
# 'dpo'     = live hosted-page checkout. Same host for test and live accounts —
#             the COMPANY TOKEN is what decides which one you are hitting.
# Keep every value UNQUOTED with no trailing `# comment` (dotenv truncates on `#`).
PAYMENT_PROVIDER=sandbox

# --- The three you must supply ---
# Merchant credential (a GUID). Treat exactly like a password: server-side
# only, never in the frontend bundle, never in a commit.
DPO_COMPANY_TOKEN=
# The numeric "Default Services Type" from the DPO portal. Not a secret, but
# createToken is rejected without a valid one.
DPO_DEFAULT_SERVICE_TYPE=
# Any random string of your choosing. Put the SAME value on the Payment
# Notification URL in the DPO portal: https://<api-host>/webhooks/psp?secret=...
# DPO does not sign callbacks, so this only blocks casual spam — the real
# check is the server-side verifyToken call.
DPO_NOTIFICATION_SECRET=

# --- Return URLs (FRONTEND, not the API) ---
# DPO sends the payer back here with TransID, CCDapproval, PnrID,
# TransactionToken and CompanyRef as GET parameters.
DPO_REDIRECT_URL=http://localhost:5173/payment/return
DPO_BACK_URL=http://localhost:5173/payment/return?cancelled=1

# --- Optional; these are already the built-in defaults ---
DPO_API_BASE_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAYMENT_PAGE_URL=https://secure.3gdirectpay.com/payv3.php
# Payment Time Limit in HOURS (sent with PTLtype=hours). DPO's own default is 96.
DPO_PTL_HOURS=24
# Estimated merchant discount rate, for display and the ledger memo only. DPO
# deducts the real fee at settlement, never from the payer.
DPO_ESTIMATED_FEE_PERCENT=3.5

# Platform commission deducted from a seller's escrow release.
PLATFORM_COMMISSION_PERCENT=0
# Hours a seller payout is held after release, so a late dispute is recoverable.
PAYOUT_HOLD_HOURS=72

# Admin seed (npm run seed) — set real values in .env only, never commit them
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_8_chars
ADMIN_NAME=Nyuwe Admin
ADMIN_PHONE=+260970000000

# Promoter (artist referral) programme — the invite key gates the hidden
# POST /promoter/signup. Share it privately with NDA'd artists only; leave
# unset to hard-disable promoter signup. Base URL builds shareable links.
PROMOTER_INVITE_KEY=change_me_share_privately_under_nda
PROMOTER_APP_BASE_URL=http://localhost:5173

# Web Push (VAPID) — background OS notifications for new inquiries. Generate a
# key pair with `npx web-push generate-vapid-keys`. The PUBLIC key must ALSO be
# set on the frontend as VITE_VAPID_PUBLIC_KEY. Leave unset to disable Web Push.
# Keep values UNQUOTED with no trailing `# comment` (dotenv truncates on `#`).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@tonsehub.com

# ── Ticket email delivery (optional) ─────────────────────────────────
# When SMTP_HOST is unset, ticket-purchase emails are skipped gracefully.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Nyuwe Tickets <no-reply@nyuwe.com>"
