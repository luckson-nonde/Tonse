# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tonse_user
DB_PASSWORD=tonse_password_secure_change_me
DB_NAME=tonse_db
# PRODUCTION: keep false — synchronize can drop columns/tables (data loss).
DB_SYNCHRONIZE=false
# PRODUCTION: set true so pending TypeORM migrations auto-apply on boot.
# NEVER enable together with DB_SYNCHRONIZE. Leave false in dev.
DB_RUN_MIGRATIONS=false
# false by default — TypeORM's query logging includes bound PARAMETER
# VALUES (pre-hash passwords, PINs, NRC numbers), not just SQL statements.
# Only turn this on temporarily for local debugging.
DB_LOGGING=false

# Comma-separated allowed browser origins in production (the frontend URL[s]),
# e.g. https://tonse.onrender.com. Only read when NODE_ENV=production.
CORS_ORIGINS=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRATION=604800

# Encryption Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_IV=your_16_character_iv_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Admin seed (npm run seed) — set real values in .env only, never commit them
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_8_chars
ADMIN_NAME=Tonse Admin
ADMIN_PHONE=+260970000000

# Promoter (artist referral) programme — the invite key gates the hidden
# POST /promoter/signup. Share it privately with NDA'd artists only; leave
# unset to hard-disable promoter signup. Base URL builds shareable links.
PROMOTER_INVITE_KEY=change_me_share_privately_under_nda
PROMOTER_APP_BASE_URL=http://localhost:5173

# Web Push (VAPID) — background OS notifications for new inquiries. Generate a
# key pair with `npx web-push generate-vapid-keys`. The PUBLIC key must ALSO be
# set on the frontend as VITE_VAPID_PUBLIC_KEY. Leave unset to disable Web Push.
# Keep values UNQUOTED with no trailing `# comment` (dotenv truncates on `#`).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@tonsehub.com
